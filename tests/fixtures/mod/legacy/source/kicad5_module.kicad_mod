(module kicad5_module (layer F.Cu) (tedit 5CD9877C)
  (descr "KiCad 5 module syntax")
  (tags "net tie 0805")
  (solder_mask_margin 0)
  (fp_text reference REF** (at 0 2) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value kicad5_module (at 0 -2 -90) (layer F.Fab) hide
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0 90) (layer F.Fab)
    (effects (font (size 0.25 0.25) (thickness 0.0625)))
  )
  (fp_text user ~RESET~ (at 1 1) (layer F.Fab)
    (effects (font (thickness 0.1)))
  )
  (fp_text user "hidden note" (at 0 3) (layer F.Fab) hide
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -0.75 -0.8) (end 2.05 -0.8) (layer F.Fab) (width 0.1))
  (fp_line (start -0.75 0.8) (end -0.75 -0.8) (layer F.SilkS) (width 0))
  (fp_circle (center 0 0) (end 0.5 0) (layer F.SilkS) (width 0))
  (fp_poly (pts (xy 1 1) (xy 2 1) (xy 2 2)) (layer F.SilkS) (width 0.1))
  (fp_poly (pts (xy -1 -1) (xy -2 -1) (xy -2 -2)) (layer Edge.Cuts) (width 0.1))
  (fp_arc (start 0 0) (end 1.5 0) (angle 90) (layer F.SilkS) (width 0.12))
  (fp_arc (start 0 0) (end 0 1.27) (angle -45) (layer F.SilkS) (width 0.12))
  (fp_arc (start 0.1 0.2) (end 1.234567 0.3) (angle 33.3) (layer F.Fab) (width 0.12))
  (pad 2 smd rect (at -0.35 0) (size 1.1 1.5) (drill (offset -0.55 0)) (layers F.Cu F.Paste F.Mask)
    (solder_paste_margin 0) (clearance 0.1))
  (pad 1 smd rect (at 0.3 0) (size 2.5 1.5) (layers F.Cu F.Paste F.Mask))
  (pad 3 thru_hole circle (at 3 0) (size 1.7 1.7) (drill 1) (layers *.Mask F.SilkS *.Cu))
  (pad 4 np_thru_hole circle (at 5 0) (size 1 1) (drill 1) (layers F&B.Cu *.Mask))
  (pad 5 smd rect (at 7 0) (size 1 1) (layers F.Paste))
  (zone (net 0) (net_name "") (layer F.Cu) (tstamp 5D0A1B2C) (hatch full 0.508)
    (connect_pads (clearance 0))
    (min_thickness 0.254)
    (keepout (tracks not_allowed) (vias not_allowed) (copperpour not_allowed))
    (fill (arc_segments 32) (thermal_gap 0.508) (thermal_bridge_width 0.508))
    (polygon (pts (xy -1 -1) (xy 1 -1) (xy 1 1) (xy -1 1)))
  )
  (zone (net 0) (net_name "") (layer F.Cu) (tstamp 5D0A1B2D) (hatch full 0.508)
    (connect_pads (clearance 0))
    (min_thickness 0.254)
    (keepout (tracks not_allowed) (vias not_allowed) (copperpour not_allowed))
    (fill (arc_segments 32) (thermal_gap 0.508) (thermal_bridge_width 0.508))
  )
  (model ${KISYS3DMOD}/Resistors_SMD.3dshapes/R_0805.wrl
    (at (xyz 0.1 0 -0.05))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 90))
  )
)
